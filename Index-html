<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Suivi Primes de Déplacement 2026</title>
    <meta name="theme-color" content="#1e3a8a">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Supabase JS -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#eff6ff', 100: '#dbeafe', 500: '#3b82f6',
                            600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="h-full font-sans text-slate-800 antialiased flex flex-col min-h-screen">

    <!-- Header Navigation -->
    <header class="bg-gradient-to-r from-brand-900 via-brand-800 to-brand-700 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-2">
            <div class="flex items-center space-x-3">
                <div class="bg-white/10 p-2.5 rounded-xl border border-white/20">
                    <i class="fa-solid fa-truck-fast text-xl text-amber-400"></i>
                </div>
                <div>
                    <h1 class="text-base sm:text-xl font-extrabold tracking-tight">Suivi Primes Déplacement</h1>
                    <p class="text-xs text-brand-100 hidden sm:block">Revalorisation au 01/10/2026 : N1 = 41€ / N2 = 83€</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="exportJSON()" title="Exporter" class="px-3 py-1.5 bg-white/10 hover:bg-white/20 rounded-lg text-xs font-semibold flex items-center space-x-1.5 border border-white/10">
                    <i class="fa-solid fa-download text-amber-300"></i>
                    <span class="hidden sm:inline">Exporter</span>
                </button>
                <button onclick="resetData()" title="Réinitialiser" class="p-2 bg-rose-500/30 hover:bg-rose-500/50 text-rose-100 rounded-lg text-xs border border-rose-300/30">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-6">

        <!-- Barre de filtre -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-brand-50 text-brand-600 rounded-lg"><i class="fa-solid fa-filter"></i></div>
                <label for="monthFilter" class="text-sm font-semibold text-slate-700">Filtrer par période :</label>
                <select id="monthFilter" onchange="renderApp()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-xl p-2.5 font-semibold">
                    <option value="ALL">Toute l'année (23 primes)</option>
                    <option value="2026-09">Septembre 2026</option>
                    <option value="2026-10">Octobre 2026</option>
                </select>
            </div>
            <div class="text-xs bg-slate-50 p-2.5 rounded-xl border border-slate-200 text-slate-600 flex items-center space-x-2">
                <i class="fa-solid fa-calculator text-brand-600"></i>
                <span>Taux Net estimé : <strong class="text-slate-800">~78 %</strong></span>
            </div>
        </div>

        <!-- Dashboard KPI -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="kpiCards"></div>

        <!-- Layout Formulaire + Tableau -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Formulaire -->
            <div class="lg:col-span-4">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
                    <h2 class="text-base font-bold text-slate-800 mb-4 pb-2 border-b">Saisir un retour de prime</h2>
                    <form id="primeForm" onsubmit="addPrime(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Date *</label>
                            <input type="date" id="dateInput" required onchange="updateTarifNotice()" class="w-full bg-slate-50 border border-slate-300 text-sm rounded-xl p-2.5 font-semibold">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Niveau *</label>
                            <select id="niveauInput" onchange="updateTarifNotice()" class="w-full bg-slate-50 border border-slate-300 text-sm rounded-xl p-2.5 font-semibold">
                                <option value="Niveau 2" selected>Niveau 2</option>
                                <option value="Niveau 1">Niveau 1</option>
                            </select>
                            <div id="tarifNotice" class="mt-1.5 text-xs font-semibold text-brand-700 bg-brand-50 border border-brand-100 p-2 rounded-lg flex justify-between">
                                <span>Montant calculé :</span>
                                <span class="font-bold text-sm" id="tarifNoticeValue">78,00 € brut</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Statut</label>
                            <select id="statutInput" class="w-full bg-slate-50 border border-slate-300 text-sm rounded-xl p-2.5 font-semibold">
                                <option value="À venir">🟠 En cours / À venir</option>
                                <option value="Payé">🟢 Payé</option>
                                <option value="Oublié">🔴 Oublié / À relancer</option>
                            </select>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Système</label>
                                <input type="text" id="systemeInput" placeholder="ex: A18D" class="w-full bg-slate-50 border border-slate-300 text-sm rounded-xl p-2 font-medium">
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Projet</label>
                                <input type="text" id="projetInput" placeholder="ex: MFM" class="w-full bg-slate-50 border border-slate-300 text-sm rounded-xl p-2 font-medium">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Remarque</label>
                            <textarea id="commentInput" rows="2" class="w-full bg-slate-50 border border-slate-300 text-sm rounded-xl p-2"></textarea>
                        </div>
                        <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-3 rounded-xl shadow-md transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-plus"></i><span>Enregistrer</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Tableau -->
            <div class="lg:col-span-8">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-4 bg-slate-50 border-b flex justify-between items-center">
                        <h2 class="text-base font-bold text-slate-800">Historique des primes</h2>
                        <span id="rowCountBadge" class="bg-slate-200 text-slate-700 text-xs font-extrabold px-2.5 py-1 rounded-full">0</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-100 text-xs uppercase font-bold text-slate-500 border-b">
                                <tr>
                                    <th class="px-4 py-3">Date</th>
                                    <th class="px-4 py-3">Système / Projet</th>
                                    <th class="px-4 py-3">Niveau</th>
                                    <th class="px-4 py-3">Brut / Net</th>
                                    <th class="px-4 py-3 text-center">Statut</th>
                                    <th class="px-4 py-3">Remarque</th>
                                    <th class="px-3 py-3 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="primeTableBody" class="divide-y divide-slate-100"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl flex items-center space-x-3">
        <i class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toastMsg" class="text-sm font-medium">Action réussie</span>
    </div>

    <!-- Script Application -->
    <script>
        const LOCAL_KEY = 'app_primes_v2026';
        const initialPrimesExcel = [
            { id: 1, date: '2026-09-02', systeme: 'A9 SOLSTICE SN02', projet: 'EAU (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Payé', comment: '' },
            { id: 2, date: '2026-09-11', systeme: 'A9 SOLSTICE SN02', projet: 'EAU (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Payé', comment: '' },
            { id: 3, date: '2026-09-14', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Payé', comment: '' },
            { id: 4, date: '2026-09-15', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Payé', comment: '' },
            { id: 5, date: '2026-09-16', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Payé', comment: '' },
            { id: 6, date: '2026-09-28', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Payé', comment: '' },
            { id: 7, date: '2026-09-29', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Payé', comment: '' },
            { id: 8, date: '2026-09-30', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Payé', comment: '' },
            { id: 9, date: '2026-09-30', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 1', brut: 39, statut: 'Payé', comment: '' },
            { id: 10, date: '2026-09-03', systeme: 'A9 SOLSTICE SN02', projet: 'EAU (ESSAIS)', niveau: 'Niveau 2', brut: 78, statut: 'Oublié', comment: 'Relancer paie' },
            { id: 11, date: '2026-10-01', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: 'Revalorisé' },
            { id: 12, date: '2026-10-05', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 1', brut: 41, statut: 'À venir', comment: '' },
            { id: 13, date: '2026-10-06', systeme: 'A18D', projet: 'MFM (ESSAIS)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 14, date: '2026-10-19', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 15, date: '2026-10-20', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 16, date: '2026-10-21', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 17, date: '2026-10-22', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 18, date: '2026-10-23', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 19, date: '2026-10-24', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 20, date: '2026-10-25', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 21, date: '2026-10-26', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 22, date: '2026-10-27', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 2', brut: 83, statut: 'À venir', comment: '' },
            { id: 23, date: '2026-10-28', systeme: 'A18D', projet: 'MFM (Caliopé)', niveau: 'Niveau 1', brut: 41, statut: 'À venir', comment: '' }
        ];

        let primes = [];

        function calculateBrut(dateStr, niveau) {
            if (!dateStr) return 0;
            const d = new Date(dateStr);
            const pivot = new Date('2026-10-01');
            if (d >= pivot) {
                return niveau === 'Niveau 1' ? 41 : 83;
            } else {
                return niveau === 'Niveau 1' ? 39 : 78;
            }
        }

        function updateTarifNotice() {
            const date = document.getElementById('dateInput').value;
            const niveau = document.getElementById('niveauInput').value;
            const brut = calculateBrut(date, niveau);
            document.getElementById('tarifNoticeValue').textContent = `${brut},00 € brut`;
        }

        function readLocal() {
            try {
                const saved = localStorage.getItem(LOCAL_KEY);
                return saved ? JSON.parse(saved) : null;
            } catch (e) { return null; }
        }

        function writeLocal() {
            try { localStorage.setItem(LOCAL_KEY, JSON.stringify(primes)); } catch (e) {}
        }

        function init() {
            primes = readLocal() || initialPrimesExcel.map(p => ({...p}));
            document.getElementById('dateInput').value = new Date().toISOString().split('T')[0];
            updateTarifNotice();
            renderApp();
        }

        function addPrime(e) {
            e.preventDefault();
            const date = document.getElementById('dateInput').value;
            const niveau = document.getElementById('niveauInput').value;
            const statut = document.getElementById('statutInput').value;
            const systeme = document.getElementById('systemeInput').value.trim();
            const projet = document.getElementById('projetInput').value.trim();
            const comment = document.getElementById('commentInput').value.trim();
            const brut = calculateBrut(date, niveau);
            const newId = primes.length > 0 ? Math.max(...primes.map(p => p.id)) + 1 : 1;

            primes.push({ id: newId, date, niveau, statut, systeme, projet, comment, brut });
            writeLocal();
            renderApp();

            document.getElementById('systemeInput').value = '';
            document.getElementById('projetInput').value = '';
            document.getElementById('commentInput').value = '';
            showToast('Prime enregistrée !');
        }

        function cycleStatut(id) {
            const p = primes.find(item => item.id === id);
            if (!p) return;
            const cycle = ['À venir', 'Payé', 'Oublié'];
            p.statut = cycle[(cycle.indexOf(p.statut) + 1) % cycle.length];
            writeLocal();
            renderApp();
            showToast(`Statut : ${p.statut}`);
        }

        function deletePrime(id) {
            if (!confirm("Supprimer cette prime ?")) return;
            primes = primes.filter(item => item.id !== id);
            writeLocal();
            renderApp();
            showToast('Prime supprimée');
        }

        function resetData() {
            if (!confirm("Réinitialiser avec les 23 primes d'origine ?")) return;
            primes = initialPrimesExcel.map(p => ({...p}));
            writeLocal();
            renderApp();
            showToast('Réinitialisé');
        }

        function exportJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(primes, null, 2));
            const a = document.createElement('a');
            a.href = dataStr;
            a.download = `primes_2026.json`;
            document.body.appendChild(a);
            a.click();
            a.remove();
            showToast('Export réussi !');
        }

        function renderApp() {
            const filterVal = document.getElementById('monthFilter').value;
            const filtered = primes.filter(p => filterVal === 'ALL' || (p.date && p.date.startsWith(filterVal)));

            let totalBrut = 0, payeBrut = 0, venirBrut = 0, oublieBrut = 0;
            filtered.forEach(p => {
                const b = Number(p.brut) || 0;
                totalBrut += b;
                if (p.statut === 'Payé') payeBrut += b;
                else if (p.statut === 'Oublié') oublieBrut += b;
                else venirBrut += b;
            });

            const net = val => Math.round(val * 0.78);

            document.getElementById('kpiCards').innerHTML = `
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 space-y-1">
                    <div class="text-slate-500 text-xs font-bold uppercase">Total Sélection</div>
                    <div class="text-2xl font-extrabold text-slate-900">${totalBrut} € <span class="text-xs text-slate-400">brut</span></div>
                    <div class="text-xs font-semibold text-emerald-600">≈ ${net(totalBrut)} € net</div>
                </div>
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 space-y-1">
                    <div class="text-slate-500 text-xs font-bold uppercase">Payé</div>
                    <div class="text-2xl font-extrabold text-emerald-600">${payeBrut} € <span class="text-xs text-slate-400">brut</span></div>
                    <div class="text-xs text-slate-500">≈ ${net(payeBrut)} € net</div>
                </div>
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 space-y-1">
                    <div class="text-slate-500 text-xs font-bold uppercase">À venir</div>
                    <div class="text-2xl font-extrabold text-amber-600">${venirBrut} € <span class="text-xs text-slate-400">brut</span></div>
                    <div class="text-xs text-slate-500">≈ ${net(venirBrut)} € net</div>
                </div>
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 space-y-1">
                    <div class="text-slate-500 text-xs font-bold uppercase">Oublié / À relancer</div>
                    <div class="text-2xl font-extrabold text-rose-600">${oublieBrut} € <span class="text-xs text-slate-400">brut</span></div>
                    <div class="text-xs text-slate-500">≈ ${net(oublieBrut)} € net</div>
                </div>
            `;

            const tbody = document.getElementById('primeTableBody');
            document.getElementById('rowCountBadge').textContent = filtered.length;
            filtered.sort((a, b) => new Date(a.date) - new Date(b.date));

            let html = '';
            filtered.forEach(p => {
                const b = Number(p.brut) || 0;
                const [yyyy, mm, dd] = p.date ? p.date.split('-') : ['--', '--', '--'];
                const dateF = p.date ? `${dd}/${mm}/${yyyy}` : '--';
                
                let badge = 'bg-amber-100 text-amber-800 border-amber-300';
                if (p.statut === 'Payé') badge = 'bg-emerald-100 text-emerald-800 border-emerald-300';
                if (p.statut === 'Oublié') badge = 'bg-rose-100 text-rose-800 border-rose-300';

                html += `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-4 py-3.5 font-semibold text-slate-800">${dateF}</td>
                        <td class="px-4 py-3.5">
                            <div class="font-bold text-slate-900">${p.systeme || '—'}</div>
                            <div class="text-xs text-slate-500">${p.projet || ''}</div>
                        </td>
                        <td class="px-4 py-3.5"><span class="px-2 py-1 rounded-lg text-xs font-bold bg-brand-50 text-brand-700">${p.niveau}</span></td>
                        <td class="px-4 py-3.5">
                            <div class="font-extrabold text-slate-900">${b} €</div>
                            <div class="text-xs text-slate-500">~${net(b)} € net</div>
                        </td>
                        <td class="px-4 py-3.5 text-center">
                            <button onclick="cycleStatut(${p.id})" class="px-3 py-1 rounded-full text-xs font-bold border shadow-sm ${badge}">${p.statut}</button>
                        </td>
                        <td class="px-4 py-3.5 text-xs text-slate-500">${p.comment || '—'}</td>
                        <td class="px-3 py-3.5 text-right">
                            <button onclick="deletePrime(${p.id})" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg"><i class="fa-solid fa-trash-can"></i></button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        function showToast(msg) {
            const t = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            t.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => t.classList.add('translate-y-20', 'opacity-0'), 3000);
        }

        window.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
